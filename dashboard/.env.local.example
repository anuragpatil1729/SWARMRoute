# SWARMRoute / SYNAPSE — local environment template
# Copy this file to `.env.local` (dashboard) and/or `.env` (Python backend)
# and fill in real values. Never commit the filled-in file.
#
# Rename to `.env.local` for the Next.js/JS dashboard, or split into a
# `.env` for the Python side if you keep them separate — the variable
# names below are what the codebase actually reads from `supabase/*`
# and the auth/order-allocation flow; adjust names only if your client
# init code uses different ones.

# ---- Supabase (dashboard / client-side) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Supabase (server-side / privileged operations, e.g. order allocation) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ---- Database (if any script/tests connect directly rather than via the client) ----
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---- App-level ----
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Optional: weather module (see src/data/weather.py in this package) ----
# Only needed if you wire in the live weather stub instead of the offline/mock provider.
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=
